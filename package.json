{
  "name": "modern-wiz-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:stdio": "tsx src/main.ts --stdio",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:stdio": "node dist/main.js --stdio",
    "auth:refresh": "node dist/main.js --refresh-only",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "markdown-it": "^14.1.0",
    "ot-json1": "^1.0.2",
    "quill-delta": "^4.2.2",
    "sharedb": "^1.9.2",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
