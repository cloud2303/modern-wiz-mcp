# 方式一：账号密码。首次登录后持久保存 token 和自动登录凭据；后续优先续期。
WIZ_USER_ID=
WIZ_PASSWORD=

# 方式二：已有 token；可自动调用 token-login 获取知识库与账号信息。
WIZ_TOKEN=
# 可选；有该凭据时优先自动登录续期。
WIZ_AUTO_LOGIN_PARAMS=
# 可选；完整已知会话可直接使用，并固定账号/知识库身份。
WIZ_SERVER_URL=
WIZ_KB_GUID=
WIZ_USER_GUID=

WIZ_REFRESH_INTERVAL_SECONDS=1800
WIZ_TIMEOUT_MS=30000
WIZ_MAX_CONCURRENT=8
WIZ_SESSION_PATH=.data/session.json
WIZ_JOURNAL_PATH=.data/writes
# true 时，保存成功后仍保留写入记录。默认删除成功记录；未确认或被拒绝的记录始终保留。
WIZ_KEEP_WRITE_JOURNAL=false

# 默认 HTTP MCP；本地客户端也可用 --stdio。
MCP_HOST=127.0.0.1
MCP_PORT=8790
# 对外监听必须设置此 token，客户端 Authorization: Bearer <token>。
MCP_AUTH_TOKEN=
# 反向代理访问时加上实际域名，以逗号分隔，只填 hostname，不带端口。
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 允许的浏览器 Origin hostname；普通 MCP 客户端无需 Origin。
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
