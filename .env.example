# 客户端请求头 Authorization: Bearer <token>。对外监听时必须设置。
MCP_AUTH_TOKEN=

# 为知账号密码。首次登录后保存会话，之后自动续期。
WIZ_USER_ID=
WIZ_PASSWORD=

MCP_HOST=127.0.0.1
MCP_PORT=8790

# 可选配置，默认值如下：
# 自托管登录地址。填写后用它登录，笔记请求使用登录返回的知识库地址
WIZ_SERVER_URL=

WIZ_REFRESH_INTERVAL_SECONDS=1800
WIZ_TIMEOUT_MS=30000
WIZ_MAX_CONCURRENT=8
WIZ_SESSION_PATH=.data/session.json
WIZ_JOURNAL_PATH=.data/writes
# 默认删除成功记录，true 时保存成功后仍保留写入记录。
WIZ_KEEP_WRITE_JOURNAL=false
